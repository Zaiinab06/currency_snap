<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/watchlist_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Header: Title, Update timestamp & Refresh action -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_watchlist_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="WATCHLIST"
            android:textColor="#F43F5E"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_watchlist_updated"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:text="Live"
            android:textColor="#9CA3AF"
            android:textSize="9sp" />

        <Button
            android:id="@+id/btn_watchlist_refresh"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:background="@drawable/widget_btn_swap"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:text="↺"
            android:textColor="#FB7185"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Empty State View -->
    <TextView
        android:id="@+id/watchlist_empty_text"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="No favorite pairs saved yet.\nTap to open CurrencySnap."
        android:textColor="#6B7280"
        android:textSize="11sp"
        android:visibility="gone" />

    <!-- Watchlist Rows Container -->
    <LinearLayout
        android:id="@+id/watchlist_rows_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Row 1 -->
        <LinearLayout
            android:id="@+id/row_1"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="2dp"
            android:paddingBottom="2dp">

            <TextView
                android:id="@+id/pair_1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.2"
                android:text="USD → PKR"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/rate_1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:text="278.25"
                android:textColor="#E5E7EB"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/change_1"
                android:layout_width="52dp"
                android:layout_height="20dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/widget_badge_pos"
                android:gravity="center"
                android:text="+0.15%"
                android:textColor="#10B981"
                android:textSize="9sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Row 2 -->
        <LinearLayout
            android:id="@+id/row_2"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="2dp"
            android:paddingBottom="2dp">

            <TextView
                android:id="@+id/pair_2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.2"
                android:text="EUR → USD"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/rate_2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:text="1.0850"
                android:textColor="#E5E7EB"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/change_2"
                android:layout_width="52dp"
                android:layout_height="20dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/widget_badge_neg"
                android:gravity="center"
                android:text="-0.22%"
                android:textColor="#EF4444"
                android:textSize="9sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Row 3 -->
        <LinearLayout
            android:id="@+id/row_3"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="2dp"
            android:paddingBottom="2dp">

            <TextView
                android:id="@+id/pair_3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.2"
                android:text="GBP → JPY"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/rate_3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:text="195.40"
                android:textColor="#E5E7EB"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/change_3"
                android:layout_width="52dp"
                android:layout_height="20dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/widget_badge_pos"
                android:gravity="center"
                android:text="+0.08%"
                android:textColor="#10B981"
                android:textSize="9sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Row 4 -->
        <LinearLayout
            android:id="@+id/row_4"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="2dp"
            android:paddingBottom="2dp">

            <TextView
                android:id="@+id/pair_4"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.2"
                android:text="USD → CAD"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/rate_4"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:text="1.3540"
                android:textColor="#E5E7EB"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/change_4"
                android:layout_width="52dp"
                android:layout_height="20dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/widget_badge_pos"
                android:gravity="center"
                android:text="+0.31%"
                android:textColor="#10B981"
                android:textSize="9sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
